generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  username         String
  email            String          @unique
  passwordHash     String
  customAvatarUrl  String?
  createdAt        DateTime        @default(now())
  isEmailVerified  Boolean         @default(false)
  
  // Статус и приватность
  isOnline         Boolean         @default(false)
  lastSeenAt       DateTime?
  isOnlineHidden   Boolean         @default(false)
  isFriendsHidden  Boolean         @default(false)
  isActivityHidden Boolean         @default(false)

  friendsCount    Int @default(0)
  sessionsCount   Int @default(0)

  // Связи
  receivedRequests Friendship[]    @relation("receiver")
  sentRequests     Friendship[]    @relation("sender")
  hostedSessions   Session[]       @relation("host")
  sessionMembers   SessionMember[]
  ratings          TrackRating[]
  playlists        Playlist[]
  addedTracks      SessionTrack[]  @relation("trackAdder")
  
  spotifyUser      SpotifyUser?

  @@index([username])
}

model SpotifyUser {
  id           String   @id @default(uuid())
  userId       String?  @unique @map("user_id")
  spotifyId    String   @unique
  displayName  String
  email        String?
  avatarUrl    String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  
  user         User?    @relation(fields: [userId], references: [id])

  @@index([displayName])
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(pending)
  createdAt  DateTime         @default(now())

  receiver   User             @relation("receiver", fields: [receiverId], references: [id])
  sender     User             @relation("sender", fields: [senderId], references: [id])

  @@index([receiverId, status])
  @@index([senderId, status])
  @@unique([senderId, receiverId])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  spotifyId   String   @unique
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model Session {
  id        String          @id @default(uuid())
  hostId    String
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  
  host      User            @relation("host", fields: [hostId], references: [id])
  members   SessionMember[]
  tracks    SessionTrack[]

  @@index([isActive])
  @@index([hostId, createdAt])
}

model SessionMember {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@unique([sessionId, userId])
}

model SessionTrack {
  id         String        @id @default(uuid())
  sessionId  String
  addedById  String?       // Кто добавил трек
  spotifyUri String
  trackName  String
  artistName String
  durationMs Int?
  addedAt    DateTime      @default(now())

  session    Session       @relation(fields: [sessionId], references: [id])
  addedBy    User?         @relation("trackAdder", fields: [addedById], references: [id])
  ratings    TrackRating[]

  @@index([sessionId, addedAt])
}

model TrackRating {
  id        String       @id @default(uuid())
  trackId   String
  userId    String
  rating    Int          @default(1) // 1 = лайк, -1 = дизлайк
  createdAt DateTime     @default(now())

  track     SessionTrack @relation(fields: [trackId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([trackId, userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Системная таблица для express-session
model SessionStore {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
}
