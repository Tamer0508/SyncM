generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id               String          @id @default(uuid())
  username         String
  email            String          @unique
  passwordHash     String
  createdAt        DateTime        @default(now())
  isEmailVerified  Boolean         @default(false)
  receivedRequests Friendship[]    @relation("receiver")
  sentRequests     Friendship[]    @relation("sender")
  hostedSessions   Session[]       @relation("host")
  sessionMembers   SessionMember[]
  ratings          TrackRating[]
  User             User?
}

model User {
  id           String   @id @default(uuid())
  app_user_id    String?  @unique
  spotifyId    String   @unique
  displayName  String
  email        String?
  avatarUrl    String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  AppUser      AppUser? @relation(fields: [app_user_id], references: [id])
}

model Friendship {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  receiver   AppUser  @relation("receiver", fields: [receiverId], references: [id])
  sender     AppUser  @relation("sender", fields: [senderId], references: [id])
}

model Session {
  id        String          @id @default(uuid())
  hostId    String
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  host      AppUser         @relation("host", fields: [hostId], references: [id])
  members   SessionMember[]
  tracks    SessionTrack[]
}

model SessionMember {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  user      AppUser  @relation(fields: [userId], references: [id])
}

model SessionTrack {
  id         String        @id @default(uuid())
  sessionId  String
  spotifyUri String
  trackName  String
  artistName String
  addedAt    DateTime      @default(now())
  session    Session       @relation(fields: [sessionId], references: [id])
  ratings    TrackRating[]
}

model TrackRating {
  id      String       @id @default(uuid())
  trackId String
  userId  String
  rating  Int
  track   SessionTrack @relation(fields: [trackId], references: [id])
  user    AppUser      @relation(fields: [userId], references: [id])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)
}
