generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())

  publicId         String    @unique
  username         String
  email            String    @unique
  passwordHash     String
  usernameChangedByUser Boolean @default(false)
  customAvatarUrl  String?
  createdAt        DateTime  @default(now())
  isEmailVerified  Boolean   @default(false)

  // Статус и приватность
  isOnline         Boolean   @default(false)
  lastSeenAt       DateTime?
  isOnlineHidden   Boolean   @default(false)
  isFriendsHidden  Boolean   @default(false)
  isActivityHidden Boolean   @default(false)
  isSearchHidden   Boolean   @default(false)

  // Кто может звать в сессию. Проверяется на сервере при создании сессии:
  // клиентская настройка, которую бэкенд не соблюдает, — не настройка.
  allowSessionInvites InviteScope @default(friends)

  // Настройки, общие для всех устройств: уведомления и оформление.
  //
  // Одна колонка, а не колонка на переключатель: набор меняется вместе с
  // интерфейсом, и каждая новая галочка не должна стоить миграции. Всё, что
  // влияет на доступ к данным, по-прежнему живёт отдельными колонками —
  // по ним ходят запросы и строятся индексы.
  preferences      Json      @default("{}")

  friendsCount    Int @default(0)
  sessionsCount   Int @default(0)

  // Связи с каскадным удалением
  receivedRequests Friendship[]    @relation("receiver")
  sentRequests     Friendship[]    @relation("sender")
  hostedSessions   Session[]       @relation("host")
  sessionMembers   SessionMember[]
  ratings          TrackRating[]
  playlists        Playlist[]
  likedTracks      LikedTrack[]
  addedTracks      SessionTrack[]  @relation("trackAdder")
  playHistory      PlayHistory[]
  blocksMade       Block[]         @relation("blocker")
  blocksReceived   Block[]         @relation("blocked")

  spotifyUser      SpotifyUser?

  @@index([username])
}

model SpotifyUser {
  id           String   @id @default(uuid())
  userId       String?  @unique @map("user_id")
  spotifyId    String   @unique
  displayName  String
  email        String?
  avatarUrl    String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade) // cascade

  @@index([displayName])
}

enum InviteScope {
  friends
  nobody
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  // Отсортированная "senderId:receiverId" — @@unique([senderId, receiverId])
  // ниже не защищает от встречной пары (A→B и B→A — разные комбинации для
  // упорядоченного уникального индекса), а pairKey защищает независимо от
  // направления. Заполняется в приложении при создании (см. sendRequest).
  pairKey    String
  status     FriendshipStatus @default(pending)
  createdAt  DateTime         @default(now())

  receiver   User             @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade) // cascade
  sender     User             @relation("sender", fields: [senderId], references: [id], onDelete: Cascade) // cascade

  @@index([receiverId, status])
  @@index([senderId, status])
  @@unique([senderId, receiverId])
  @@unique([pairKey])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  spotifyId   String?
  name        String
  description String?
  imageUrl    String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  playlistTracks PlaylistTrack[]

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) // cascade

  @@index([userId])
  // NULL в spotifyId не конфликтует сам с собой в Postgres, так что кастомные
  // плейлисты (spotifyId: null) этим ограничением не затрагиваются — защищает
  // только повторный импорт одного и того же Spotify-плейлиста одним юзером.
  @@unique([userId, spotifyId])
}

model PlaylistTrack {
  id          String   @id @default(uuid())
  playlistId  String
  spotifyUri  String
  trackName   String
  artistName  String
  imageUrl    String?
  durationMs  Int?
  position    Int      @default(0)
  addedAt     DateTime @default(now())

  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade) // already cascade

  @@unique([playlistId, spotifyUri])
  @@index([playlistId, position])
}

model LikedTrack {
  id          String   @id @default(uuid())
  userId      String
  spotifyUri  String
  trackName   String
  artistName  String
  // Обложка. Nullable, потому что у записей, сделанных до этой колонки, её
  // нет — они дозаполняются из Spotify при первом чтении списка.
  imageUrl    String?
  likedAt     DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) // cascade

  @@unique([userId, spotifyUri])
}

model Session {
  id        String          @id @default(uuid())
  hostId    String
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  host      User            @relation("host", fields: [hostId], references: [id], onDelete: Cascade) // cascade
  members   SessionMember[]
  tracks    SessionTrack[]

  @@index([isActive])
  @@index([hostId, createdAt])
}

enum SessionMemberStatus {
  pending
  accepted
  declined
}

model SessionMember {
  id        String              @id @default(uuid())
  sessionId String
  userId    String
  status    SessionMemberStatus @default(pending)
  joinedAt  DateTime            @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade) // cascade
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // cascade

  @@index([sessionId])
  @@index([userId])
  @@unique([sessionId, userId])
}

model SessionTrack {
  id         String        @id @default(uuid())
  sessionId  String
  addedById  String?       // Кто добавил трек
  spotifyUri String
  trackName  String
  artistName String
  imageUrl   String?
  durationMs Int?
  addedAt    DateTime      @default(now())

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade) // cascade
  addedBy    User?         @relation("trackAdder", fields: [addedById], references: [id], onDelete: SetNull) // если пользователь удалён, оставляем трек, но обнуляем автора
  ratings    TrackRating[]

  @@index([sessionId, addedAt])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@index([blockerId])
  @@index([blockedId])
  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model PlayHistory {
  id         String   @id @default(uuid())
  userId     String
  spotifyUri String
  trackName  String
  artistName String
  // См. LikedTrack.imageUrl — та же история и то же дозаполнение.
  imageUrl   String?
  playedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // cascade

  @@index([userId, playedAt])
}

model TrackRating {
  id        String       @id @default(uuid())
  trackId   String
  userId    String
  rating    Int          @default(1) // 1 = лайк, -1 = дизлайк
  createdAt DateTime     @default(now())

  track     SessionTrack @relation(fields: [trackId], references: [id], onDelete: Cascade) // cascade
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade) // cascade

  @@unique([trackId, userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Системная таблица для express-session
model SessionStore {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
}
